# Motus extended 48-action preset.

MOTUS_EXTENDED_HORIZON=1
MOTUS_EXTENDED_HORIZON_MULTIPLIER=3

# Keep the 48-action branch aligned with chunk-level causal semantics.
MOTUS_EXTENDED_PREFIX_MASK=1
MOTUS_EXTENDED_PREFIX_MASK_BACKEND=chunk_causal

# By default deployment executes the first base chunk from the 48-action output.
# Set MOTUS_EXEC_ACTIONS to a smaller value only for low-level control tests.
